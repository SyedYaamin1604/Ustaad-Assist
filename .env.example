# Copy this file to .env.local and fill it in, then restart Expo (npx expo start -c).
# Only PUBLIC values belong here — everything below ships inside the app.
# Never put the Supabase service role key or DATABASE_URL in this app.

# The Express backend. No trailing slash.
#   Local backend + Android emulator:  http://10.0.2.2:4000
#   Local backend + physical phone:    http://<your computer's LAN IP>:4000
#   Deployed:                          https://<your-app>.vercel.app
EXPO_PUBLIC_API_URL=

# Supabase project (Dashboard -> Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://hgmduhkbagolwnmgvqux.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Storage bucket for material, class-list photos and course outlines.
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=materials

# Show "Continue with Google". Enable the Google provider in Supabase first.
EXPO_PUBLIC_GOOGLE_SIGNIN=false

# Optional: pretend today is this date when talking to the planner, to demo a
# seeded semester (the backend seed uses 2026-11-18). Leave empty normally.
EXPO_PUBLIC_DEMO_TODAY=
